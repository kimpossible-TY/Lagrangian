+def read_document_focus(previews):
+    """Resolve saved text within one document, retaining each adapter's checks."""
+    records=[]; errors=[]
+    for preview in previews:
+        try:
+            record=read_focus(preview)
+            if not isinstance(record,dict): raise ValueError('Invalid focus response')
+            records.append((preview,record))
+        except (OSError,ValueError,RuntimeError,KeyError,TypeError) as error:
+            errors.append({'id':preview['id'],'error':str(error)})
+    selected=[(preview,record) for preview,record in records
+        if record.get('service_matches') is True
+        and record.get('status') in {'selected','unmapped'}
+        and type(record.get('selected_at_unix_ms')) is int
+        and record['selected_at_unix_ms']>0]
+    saved=[(preview,record) for preview,record in selected
+        if isinstance(record.get('selection'),dict)
+        and isinstance(record['selection'].get('text'),str)
+        and record['selection']['text'].strip()]
+    choices=saved or selected
+    if choices:
+        latest=max(record['selected_at_unix_ms'] for _,record in choices)
+        winners=[(preview,record) for preview,record in choices
+            if record['selected_at_unix_ms']==latest]
+        if len(winners)==1:
+            preview,record=winners[0]
+            result={**record,'preview':preview_info(preview),'needs_preview_selection':False,
+                'resolution':'latest_saved_text' if saved else 'latest_location'}
+        else:
+            result={'status':'ambiguous','needs_reselection':False,'needs_preview_selection':True,
+                'message':'Saved contexts have identical timestamps; specify a Preview ID.',
+                'candidates':[preview_info(preview) for preview,_ in winners]}
+    else:
+        result={'status':'not_ready' if errors else 'waiting','needs_reselection':True,
+            'needs_preview_selection':False,'selection_usable':False,
+            'message':'이 문서의 Reader에서 Save for Codex로 텍스트를 저장해 주세요.',
+            'previews':[preview_info(preview) for preview in previews]}
+    if errors: result['context_read_errors']=errors
+    return result
