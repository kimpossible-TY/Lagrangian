+<!doctype html>
+<html lang="ko" data-theme="dark">
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>문서 보기 선택 검증</title>
+<link rel="stylesheet" href="../public/style.css">
+<style>main{max-width:720px;margin:auto;padding:16px}#entry-report{white-space:pre-wrap;font:13px/1.6 monospace;overflow-wrap:anywhere}</style>
+<main><h1>문서 보기 선택 검증</h1><p>터치 환경과 서비스 상태를 모의한 독립 검사입니다.</p><span id="hosting-time"></span><div id="hosting-services"></div><pre id="entry-report"></pre></main>
+<script type="module">
+import {renderHosting,hostingModel} from '../public/hosting.js';
+const output=document.querySelector('#entry-report');
+const phase=new URL(location.href).searchParams.get('phase');
+const report=phase==='2'?JSON.parse(sessionStorage.getItem('hosting-entry-test')||'{"checks":[],"errors":[]}'):{checks:[],errors:[]};
+report.width=innerWidth;report.simulatedTouch=true;
+const normalMedia=window.matchMedia.bind(window);
+window.matchMedia=query=>query==='(any-pointer: coarse)'?{matches:true}:normalMedia(query);
+const now=Date.now()/1000;
+const project={id:'/fixtures/pde',name:'PDE 보기 선택 검증'};
+const service=(id,name,path,kind)=>({id,name,kind,entrypoint:'main.typ',project,url:new URL(path,location.href).href,registration:'managed',registrationCheck:{state:'ok'},process:{state:'running'},listener:{state:'ok'},http:{state:'ok',status:200},checkedAt:now});
+const paged=service('pde','원본 페이지','fixtures/entry-paged.html','typst-always-preview');
+const reader=service('pde-reader','읽기 화면','fixtures/entry-reader.html','typst-reader');
+reader.compile={state:'ok',checkedAt:now-3600,observedAt:now,revision:'accepted-fixture',development:false,semanticCanvases:true};
+const payload={now,status:{schemaVersion:1,collectedAt:now,services:[paged,reader]}};
+const projectID=hostingModel(payload).projects[0].id;
+const key=`tail-dashboard:document-view:${projectID}`;
+const select=()=>document.querySelector('[data-reading-project]');
+const link=()=>document.querySelector('.hosting-reading .status-link');
+function check(name,value){report.checks.push(name);if(!value)report.errors.push(name);output.textContent=JSON.stringify(report,null,2);}
+function choose(value){const node=select();node.focus();node.value=value;node.dispatchEvent(new Event('change',{bubbles:true}));}
+try{
+ if(phase!=='2')localStorage.removeItem(key);
+ renderHosting(payload);
+ if(phase!=='2'){
+  check('a touch device opens the published Reader automatically',select().value==='auto'&&link().href===reader.url);
+  choose('paged');
+  check('an explicit page preference keeps the original endpoint',link().href===paged.url);
+  check('changing the preference retains keyboard focus',document.activeElement===select());
+  reader.checkedAt+=1;payload.now+=1;payload.status.collectedAt+=1;
+  renderHosting(payload);
+  check('status refresh preserves the page preference',select().value==='paged'&&link().href===paged.url);
+  choose('reader');
+  check('the Reader preference is saved',localStorage.getItem(key)==='reader');
+  sessionStorage.setItem('hosting-entry-test',JSON.stringify(report));
+  location.replace('hosting-entry-browser.html?phase=2');
+ }else{
+  check('a fresh page restores the Reader preference',select().value==='reader'&&link().href===reader.url);
+  reader.compile.development=true;renderHosting(payload);
+  check('an explicit Reader choice can evaluate the development version',link().href===reader.url);
+  choose('auto');
+  check('automatic selection does not promote the development Reader',link().href===paged.url);
+  reader.compile.development=false;renderHosting(payload);
+  check('a validated publication enables automatic reading',link().href===reader.url);
+  reader.compile.state='failed';renderHosting(payload);
+  check('a failed save retains the accepted Reader entry',link().href===reader.url);
+  reader.compile.revision=null;renderHosting(payload);
+  check('a Reader with no published document falls back to pages',link().href===paged.url);
+  const descriptor=Object.getOwnPropertyDescriptor(window,'localStorage');
+  Object.defineProperty(window,'localStorage',{configurable:true,get(){throw new Error('Fixture storage unavailable');}});
+  try{choose('reader');check('unavailable storage still honors the current explicit choice',select().value==='reader'&&link().href===reader.url);}
+  finally{if(descriptor)Object.defineProperty(window,'localStorage',descriptor);else delete window.localStorage;}
+  reader.compile.state='ok';reader.compile.revision='accepted-fixture';choose('auto');
+  const root=document.querySelector('main');
+  check('the controls remain within the reading viewport',root.scrollWidth<=root.clientWidth+1&&document.documentElement.scrollWidth<=document.documentElement.clientWidth+1);
+  check('the original addresses remain in the details view',payload.status.services[0].url===paged.url&&payload.status.services[1].url===reader.url);
+  document.body.dataset.entryState=report.errors.length?'error':'ready';
+ }
+}catch(error){report.errors.push(String(error));document.body.dataset.entryState='error';output.textContent=JSON.stringify(report,null,2);}
+</script>
+</html>
